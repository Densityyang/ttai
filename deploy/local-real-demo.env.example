# Local real-data demo launch profile (EXAMPLE - SECRET FREE).
#
# Copy to your own untracked file (or export these variables) before launching
# the stock application with:
#
#     python main.py dev
#
# This profile activates the ONE frozen real-data case end to end with ZERO model
# calls.  It contains NO database password, NO SSH password and NO model key;
# the database credential is read from a FILE that is never committed.

# --- service identity -------------------------------------------------------
# infra-dev: a local development deployment, never a production deployment.
SERVICE_MODE=infra-dev
# Authentication is off because this is a local demo; the server-owned demo
# identity below is used instead of any client-supplied identity.
AUTH_ENABLED=false
MEMORY_BACKEND=memory

# --- local real-data activation ---------------------------------------------
# This is the ONLY value that activates the local-real authority and the
# local-real typed runtime.  It is rejected together with SERVICE_MODE=product.
TYPED_RUNTIME_ACTIVATION=local_real_data_demo

# The server-owned identity for the local-real demo.  It is NEVER taken from a
# request body, query, header or cookie.
LOCAL_REAL_DEMO_USER_ID=local-real-demo

# The ONLY user allowed to perform LOCAL-DEMO certification.  This is an
# explicit configured identity, never inferred from a role or from ownership.
LOCAL_DEMO_CERTIFICATION_ADMIN_USER_ID=local-real-demo

# --- model ------------------------------------------------------------------
# Mode1 QUERY is deterministic and model-free; the model is not required for
# this profile and is not contacted.
MODEL_REQUIRED=false

# --- database ---------------------------------------------------------------
# The READ-ONLY business DSN is read from a FILE so no credential enters the
# environment, the process table or this repository.  The file itself is
# gitignored and must contain the DSN as its only content.
DATABASE_URL_FILE=secrets/database/business_ro_database_url

# --- published AI views -----------------------------------------------------
AI_VIEWS_CONFIG_PATH=configs/semantic/ai_views.yaml
NL2SQL_DB_SCHEMA=ai_views
AI_VIEWS_AUTO_SYNC=false

# --- browser / CORS ---------------------------------------------------------
# Explicit local origins only; a wildcard is forbidden when credentials are on.
CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOW_CREDENTIALS=false

# --- observability ----------------------------------------------------------
LANGFUSE_ENABLED=false
