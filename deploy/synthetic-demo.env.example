# Synthetic local product-flow profile (EXAMPLE - SECRET FREE).
#
# This profile is suitable for UI/product-flow development without a business
# database. It is synthetic authority and never satisfies real-data acceptance.
# Launch with the stock application after exporting these variables, for
# example: python main.py dev

SERVICE_MODE=infra-dev
AUTH_ENABLED=false
MEMORY_BACKEND=memory
TYPED_RUNTIME_ACTIVATION=demo_synthetic_authorization
DEMO_SYNTHETIC_USER_ID=demo-analyst
LOCAL_DEMO_CERTIFICATION_ADMIN_USER_ID=demo-analyst
MODEL_REQUIRED=false
CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOW_CREDENTIALS=false
LANGFUSE_ENABLED=false
