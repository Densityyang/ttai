# ============================================================
# 环境配置
# ============================================================
# ENV=dev  # 环境标识: dev/test/prod，会加载对应的 .env.{ENV} 文件

# ============================================================
# 数据库配置
# ============================================================
# 日常查询连接（建议使用只读用户，最小权限原则）
DATABASE_URL=postgresql+asyncpg://agent_reader_user:your_password@127.0.0.1:7432/tt_db

# 管理员连接（可选，用于启动时自动创建 schema/视图等 DDL 操作）
# 未配置时 ai_views_auto_sync 将使用 DATABASE_URL 执行 DDL
DATABASE_URL_ADMIN=postgresql+asyncpg://tt_admin:your_password@127.0.0.1:7432/tt_db

# ============================================================
# LLM 配置 - 选择一个提供商
# ============================================================

# 方案 1: 移动九天 API
# OPENAI_API_KEY=your-jiutian-api-key
# OPENAI_BASE_URL=https://jiutian.10086.cn/largemodel/moma/api/v3
# MODEL_NAME=jiutian-lan-comv3

# 方案 2: NVIDIA API (推荐)
OPENAI_API_KEY=your-nvidia-api-key
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
MODEL_NAME=qwen/qwen3-next-80b-a3b-instruct

# 方案 3: OpenAI 官方 API
# OPENAI_API_KEY=sk-your-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# MODEL_NAME=gpt-4o

# 方案 4: 其他 OpenAI 兼容 API (如 Azure OpenAI, 本地 Ollama 等)
# OPENAI_API_KEY=your-api-key
# OPENAI_BASE_URL=http://localhost:11434/v1
# MODEL_NAME=llama3

# ============================================================
# Embedding 配置 - 用于向量检索
# ============================================================
EMBEDDING_API_KEY=not-needed
EMBEDDING_BASE_URL=http://127.0.0.1:1234/v1
EMBEDDING_MODEL=text-embedding-mxbai-embed-large-v1

# ============================================================
# RAG 配置 - 问答样本检索增强
# ============================================================
# 问答样本文件路径
RAG_QA_FILE_PATH=sql_examples/qa.md

# FAISS 向量索引存储路径
RAG_FAISS_INDEX_PATH=.vector_store/nl2sql_by_toolcall_qa

# 检索返回的相似样本数量
RAG_TOP_K=3

# RAG 相关性阈值（distance 越小越相关）
RAG_RELEVANCE_THRESHOLD=1.0

# 文本分片大小（字符数）
RAG_CHUNK_SIZE=500

# 分片重叠大小（字符数），用于保持上下文连贯性
RAG_CHUNK_OVERLAP=80

# ============================================================
# Agent 配置
# ============================================================
# SQL 查询默认返回的最大行数
SQL_TOP_K=5

# Agent 最大 LLM 调用次数（防止无限循环）
MAX_LLM_CALLS=30

# 子 Agent 调用超时时间（秒）
GRAPH_TIMEOUT=300

# ============================================================
# AI 视图配置 - 核心配置项（三者需保持一致）
# ============================================================
# SQL 查询默认 schema，决定 AI 可见的视图范围
# - 默认值: ai_views（推荐，与 YAML 配置保持一致）
# - 生产环境: 建议使用独立 schema，与业务表隔离
# - 切换影响: 需同步更新 ai_views.yaml 中的 schema 字段
NL2SQL_DB_SCHEMA=ai_views

# 启动时是否自动同步 ai 视图（基于 YAML 配置）
# - true: 启动时自动创建/更新 schema 和视图（推荐）
# - false: 跳过自动同步，需手动执行 DDL 或通过 CI/CD 同步
# - 注意: 生产环境建议开启，确保视图定义与代码版本一致
AI_VIEWS_AUTO_SYNC=true

# ai 视图 YAML 配置路径
# - 用于定义 AI 可查询的视图结构（表、字段、过滤条件等）
# - 路径相对于项目根目录，也可使用绝对路径
# - 配置格式参考: configs/semantic/ai_views.yaml
AI_VIEWS_CONFIG_PATH=configs/semantic/ai_views.yaml

# ============================================================
# 对话记忆压缩配置 - 控制上下文长度
# ============================================================
# 是否启用对话记忆压缩
MEMORY_SUMMARY_ENABLED=true

# 触发压缩的消息条数阈值
MEMORY_SUMMARY_TRIGGER_MESSAGES=80

# 触发压缩的 token 数阈值（可选，不设置则不按 token 触发）
# MEMORY_SUMMARY_TRIGGER_TOKENS=3000

# 压缩触发模式: any=命中任一阈值触发, all=命中全部阈值触发
MEMORY_SUMMARY_TRIGGER_MODE=any

# 压缩后保留的最近消息条数
MEMORY_SUMMARY_KEEP_MESSAGES=20

# 摘要前最多保留的历史 token 数（可选，不设置则不裁剪）
MEMORY_SUMMARY_TRIM_TOKENS=4000

# ============================================================
# 可观测性配置 - Langfuse 监控
# ============================================================
# 是否启用 Langfuse 监控
LANGFUSE_ENABLED=false

# Langfuse 公钥（启用时必填）
# LANGFUSE_PUBLIC_KEY=pk-lf-xxx

# Langfuse 私钥（启用时必填）
# LANGFUSE_SECRET_KEY=sk-lf-xxx

# Langfuse 服务地址（可选，默认使用官方云服务）
# LANGFUSE_HOST=https://cloud.langfuse.com

# 本地部署示例
# LANGFUSE_HOST=http://127.0.0.1:3000

# ============================================================
# 认证配置 - 复用 tt-api 的鉴权体系
# ============================================================
# 是否启用鉴权（生产环境建议启用）
AUTH_ENABLED=true

# tt-api 服务基础地址（启用鉴权时必填）
TT_API_BASE_URL=http://127.0.0.1:9000

# tt-api 当前用户信息接口路径
TT_API_AUTH_INFO_PATH=/vadmin/auth/user/admin/current/info

# 鉴权请求超时时间（毫秒）
AUTH_VERIFY_TIMEOUT_MS=1500

# 鉴权结果缓存时间（秒）
AUTH_CACHE_TTL_SECONDS=60

# invoke 接口需要的权限点
AUTH_REQUIRED_PERMISSION_INVOKE=nl2sql:invoke

# stream 接口需要的权限点
AUTH_REQUIRED_PERMISSION_STREAM=nl2sql:stream

# ============================================================
# API 服务配置
# ============================================================
# API 服务监听端口
# 启动时 RAG：无可用 EMBEDDING 服务时可跳过 FAISS 同步（测试/容器环境）
# SKIP_RAG_STARTUP_SYNC=true
# RAG_STARTUP_SYNC_STRICT=false

API_PORT=9001

# 日志级别: DEBUG/INFO/WARNING/ERROR/CRITICAL
LOG_LEVEL=INFO

# ============================================================
# 存储路径配置
# ============================================================
# 向量存储根目录
VECTOR_STORE_PATH=.vector_store

# Trace 日志目录
TRACE_DIR=.traces
